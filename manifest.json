{
  "manifest_version": 3,
  "name": "MyFav — Mes favoris",
  "version": "1.1.0",
  "description": "Recherchez et ouvrez vos favoris Chrome instantanément : popup, bibliothèque visuelle et mot-clé « fav » dans la barre d'adresse.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage"
  ],
  "action": {
    "default_title": "MyFav — Rechercher dans mes favoris",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "fav"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Rechercher dans mes favoris"
    },
    "open-library": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Ouvrir la bibliothèque MyFav"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}